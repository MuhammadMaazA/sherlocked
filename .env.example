# Names only. On the workshop VM these are already exported.
# Never commit real values.

# vast | mock
VIDEO_PROVIDER=vast
# wandb | none
REASONING_PROVIDER=wandb

# Retrieval API. The app reads VSS_* first, then the workshop names.
VSS_URL=
VSS_USERNAME=
VSS_PASSWORD=
INGRESS_URL=
USERNAME=
PASSWORD=

# Weights & Biases serverless inference. Optional; the engine still returns
# evidence-backed findings when this is unset.
WANDB_API_KEY=
WANDB_TEAM=
WANDB_PROJECT=
WANDB_MODEL=meta-llama/Llama-3.1-8B-Instruct
WANDB_BASE_URL=https://api.inference.wandb.ai/v1

# SQLite path for cases. Video evidence stays in VAST.
SHERLOCKED_DB=./data/sherlocked.db

# Frontend build prefix. Use / for local, /app/ for the workshop Ingress.
VITE_BASE=/
